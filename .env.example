# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000

# "sandbox" while testing, "production" once you're ready to take real payments
APP_ENV=sandbox

# The public URL of your deployed site (no trailing slash).
# Locally this is http://localhost:3000
SITE_URL=http://localhost:3000

# From comercios.wompi.co -> Developers -> Secrets for technical integration
# Sandbox keys start with pub_test_ / test_integrity_ / test_events_
# Production keys start with pub_prod_ / prod_integrity_ / prod_events_
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxxxxxxxxxx

# The password used to log into /admin (the store management panel).
# Make this long and random — it's the only thing standing between the
# internet and your product catalog + customer orders.
ADMIN_TOKEN=change-this-to-a-long-random-password

# Random string used to cryptographically sign admin session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If you don't set this, the server makes up a temporary one on each boot,
# which logs every admin out whenever the server restarts.
SESSION_SECRET=change-this-to-a-long-random-string

# Timezone the store operates in. Deleted products/photos go to the admin
# Trash tab and are permanently cleared automatically every day at 11:59am
# in THIS timezone (not the server's own timezone). Use an IANA name, e.g.
# America/Bogota, America/Mexico_City, America/New_York.
STORE_TIMEZONE=America/Bogota

# ---- WhatsApp order messaging (optional) ----
# Lets the admin send shipping updates/photos to a customer's WhatsApp from
# the Orders tab, and see their replies there. Requires a Meta WhatsApp
# Business Cloud API app — see the "WhatsApp order messaging" section in
# README.md for the full setup walkthrough. Leave these blank to disable the
# feature; the admin panel will say so and nothing will break.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
# Any string you make up — you'll enter this same value in the Meta webhook setup screen.
WHATSAPP_VERIFY_TOKEN=
# From the Meta App's Settings -> Basic page. Used to verify inbound webhook requests are really from Meta.
WHATSAPP_APP_SECRET=
