# Copy this file to .env and fill in real values. Never commit .env.

PORT=3000

# "sandbox" while testing, "production" once you're ready to take real payments
APP_ENV=sandbox

# The public URL of your deployed site (no trailing slash).
# Locally this is http://localhost:3000
SITE_URL=http://localhost:3000

# From comercios.wompi.co -> Developers -> Secrets for technical integration
# Sandbox keys start with pub_test_ / test_integrity_ / test_events_
# Production keys start with pub_prod_ / prod_integrity_ / prod_events_
WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_INTEGRITY_SECRET=test_integrity_xxxxxxxxxxxxxxxxxxxxxxxx
WOMPI_EVENTS_SECRET=test_events_xxxxxxxxxxxxxxxxxxxxxxxx

# The password used to log into /admin (the store management panel).
# Make this long and random — it's the only thing standing between the
# internet and your product catalog + customer orders.
ADMIN_TOKEN=change-this-to-a-long-random-password

# Random string used to cryptographically sign admin session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If you don't set this, the server makes up a temporary one on each boot,
# which logs every admin out whenever the server restarts.
SESSION_SECRET=change-this-to-a-long-random-string

# Deleted products, photos, and orders go to a Recently Deleted list and
# are permanently cleared automatically 30 days after deletion — no env
# var needed for this, it's the same everywhere.

# No WhatsApp API keys needed — the admin panel's "Message on WhatsApp"
# button just opens a chat in the admin's own WhatsApp app/Web with the
# customer's number pre-filled. Nothing to configure here.

# Optional — only needed for the "Email receipt" button in an order's
# Manage panel (viewing/printing a receipt works without this). Any SMTP
# provider works. Easiest free option: a Gmail account with a 16-character
# "app password" (Google Account -> Security -> 2-Step Verification ->
# App passwords) — do NOT use your normal Gmail password here.
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=465
#   SMTP_USER=youraddress@gmail.com
#   SMTP_PASS=your16charapppassword
# Other free options that work the same way: Brevo, Resend, Mailgun —
# any of them will give you an SMTP host/port/username/password to paste in.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
# What shows in the customer's inbox as the sender. Defaults to SMTP_USER if left blank.
SMTP_FROM=MiTienda by COLHQ <youraddress@gmail.com>
